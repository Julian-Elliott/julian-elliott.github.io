</div>

<script>
  // "Someone at home" block: best and worst three-hour windows, recomputed from whatever Fig. 1 shows.
  document.addEventListener('fig1:change', (e: any) => {
    const s: { t: string; v: number }[] = e.detail.series;
    const live = e.detail.mode === 'live';
    const win = 6;
    let bi = 0, wi = 0, bm = Infinity, wm = -Infinity;
    for (let k = 0; k + win <= s.length; k++) {
      const m = s.slice(k, k + win).reduce((a, h) => a + h.v, 0) / win;
      if (m < bm) { bm = m; bi = k; }
      if (m > wm) { wm = m; wi = k; }
    }
    const span = (k: number) => `${s[k].t}–${s[Math.min(s.length - 1, k + win)].t}`;
    const best = document.getElementById('home-best'), worst = document.getElementById('home-worst');
    if (best) best.textContent = `Cheapest three hours ${live ? 'today' : 'that day'}: ${span(bi)}, averaging ${Math.round(bm)} g/kWh.`;
    if (worst) worst.textContent = `Dearest: ${span(wi)} at ${Math.round(wm)} g/kWh, a factor of ${(wm / Math.max(1, bm)).toFixed(1)}.`;
  });
</script>
</Base>
